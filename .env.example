DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

POSTGRES_DB=control_dashboard
POSTGRES_USER=control_dashboard
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# اختر وحدة بس حسب أي مفتاح وصل: anthropic / openai / gemini
LLM_PROVIDER=anthropic

