# مفتاح جانغو السرّي — إلزامي بالإنتاج. أوامر manage.py (migrate/check/runserver) بترفض تشتغل
# (فحص apitokens.E003؛ gunicorn لحاله ما بيشغّل الفحوصات، فلا تتخطى migrate و check --deploy) لما
# DJANGO_DEBUG=0 والمفتاح ضعيف أو placeholder (django-insecure..., change-me, secret, أقصر من
# 50 حرف، أو أقل من 12 حرف مختلف). ليش مهم: توكنات هوية الزبون (جلسة v2 + المتسوّق) موقّعة
# فيه، فالمفتاح الضعيف = أي حدا بيقدر يزوّر هويات الزبائن ويقرا/يمسح ذاكرتهم.
# ولّد واحد وحطه هون (ولا ترفعه بالمستودع؛ تغييره بيلغي توكنات الزبائن الحالية):
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=<الصق الناتج هون>
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# عنوان حقيقي يوصله إنترنت (https://...) — بيستخدم لبناء رابط الـ webhook
# اللي منسجله عند Shopify لحظة ربط تاجر. لا تحطه localhost بالإنتاج.
SITE_BASE_URL=https://your-domain.com

POSTGRES_DB=control_dashboard
POSTGRES_USER=control_dashboard
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# كم ثانية بتضل اتصالات القاعدة مفتوحة بين الطلبات (0 = اتصال جديد لكل طلب).
POSTGRES_CONN_MAX_AGE=60

# اختر وحدة بس حسب أي مفتاح وصل: anthropic / openai / gemini
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# gpt-6-luna: أرخص وأقوى من gpt-4o بالتجربة (لغة ولهجة الزبون، الإقناع، كود الخصم).
# gpt-5.4-mini رد بالعربي على زبون عم يحكي إنجليزي، فاستبعدناه.
# OPENAI_REASONING_EFFORT: قديش يفكّر الموديل قبل ما يرد (low/medium/high) عبر الـ
# Responses API. فاضي = ما منبعته أبداً (لازم للموديلات القديمة مثل gpt-4o).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# الطبقة المجانية لـ Gemini = 15 طلب بالدقيقة بس: ما بتكفي دور v2 (2 إلى 4 استدعاءات تسلسلية).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- ذاكرة الزبون (v2) ----
# محلّل الذاكرة (بيستخرج التفضيلات والاعتراضات من كلام الزبون): فاضي = نفس مزوّد وموديل
# الدردشة. تقدر تحط موديل أرخص/أسرع له (ANALYZER_PROVIDER: anthropic / openai / gemini / groq).
ANALYZER_PROVIDER=
ANALYZER_MODEL=
# عمر توكن الجلسة بالثواني (بيتجدد مع كل دور). افتراضي = 24 ساعة.
V2_SESSION_TTL_SECONDS=86400
# عمر توكن هوية المتسوّق بالثواني. افتراضي = 180 يوم. الاحتفاظ الفعلي بالبيانات بالسيرفر
# بيحدده profile_retention_days لكل تاجر (افتراضي 90) + أمر purge_expired_data اليومي.
V2_SHOPPER_TTL_SECONDS=15552000

# ---- تحديد معدّل الطلبات + الـ proxy ----
# مخزن عدّادات المعدّل: database (افتراضي، بلا بنية جديدة) أو cache (Redis/Memcached مشترك
# بس — فحص النظام apitokens.E002 بيرفض LocMem/ملفات). بعد النشر شغّل: manage.py ratelimit_selftest
RATE_LIMIT_BACKEND=database
# عدد الـ proxies الموثوقة قدام جانغو (nginx = 1). لازم nginx يمرّر X-Forwarded-For. 0 = تجاهل الهيدر.
# قيمة غلط = إما كل الزبائن بنفس الـ IP (حدود تنضرب) أو IP مزوّر (حدود تتجاوز).
TRUSTED_PROXY_COUNT=1

# ---- مصادقة endpoint الاستهلاك (n8n) ----
# internal (افتراضي) = التوكن العلني القديم مقبول بس من الشبكات المحددة تحت؛ off = مرفوض
# كلياً (الهدف النهائي: n8n يبعت X-Consume-Key، دوّره من لوحة التحكم). نفس السيرفر = loopback.
CONSUME_LEGACY_MODE=internal
# CIDR مفصولة بفاصلة. لو n8n على سيرفر تاني حط عنوانه هون (مؤقتاً لحد ما تنتقل لمفتاح الاستهلاك).
CONSUME_LEGACY_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# 30 يوم HSTS بالإنتاج (DJANGO_DEBUG=0). بدون includeSubDomains.
DJANGO_HSTS_SECONDS=2592000

# مفتاح kie.ai — لتوليد صور تجربة اللبس (virtual try-on)
KIEAI_API_KEY=

# توكن التاجر يلي بيعرض متجر الديمو (/demo/) — انسخه من لوحة التحكم.
# فاضي = متجر الديمو مطفي (كل صفحات /demo/ بترجع 404).
DEMO_STORE_KEY=

# تطبيق سلة — من بوابة الشركاء: portal.salla.partners ← My Apps
SALLA_APP_ID=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_DEFAULT_IMAGE_QUOTA=20

# تطبيق زد — من بوابة الشركاء: partner.zid.sa ← My Apps ← General settings ← API keys
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# كلمة سر عشوائية منحطها كهيدر مخصص بتبويب Webhooks بزد (زد ما بتوقّع الإشعارات)
ZID_WEBHOOK_SECRET=
ZID_DEFAULT_IMAGE_QUOTA=20
# رصيد الصور الشهري لكل باقة: اسم الباقة أو رقمها ← عدد الصور (JSON بسطر واحد)
ZID_PLAN_QUOTAS={"Basic": 100, "Growth": 500, "Pro": 1000}

# إيميل الدعم — بيظهر بصفحة سياسة الخصوصية
SUPPORT_EMAIL=

# --- تحديد المعدّل (الودجت علني، فالـ endpoints محمية بحدود) ---
# "database" (الافتراضي): العدّادات بجدول بقاعدة البيانات، مشتركة بين كل الـ workers والسيرفرات.
# "cache": فقط لو CACHES مضبوط على Redis/Memcached (فحص النظام بيرفض LocMem/File-based).
# بعد النشر شغّل: python manage.py ratelimit_selftest
RATE_LIMIT_BACKEND=database
# عدد الـ proxies الموثوقة قدام جانغو (nginx = 1). لازم nginx يضيف X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# --- اعتماد endpoint الاستهلاك (n8n): /api/tokens/consume/ ---
# الأساسي: مفتاح الاستهلاك السرّي (X-Consume-Key) — بيتولّد من الداشبورد (عمود "استهلاك")
# وبيظهر مرة وحدة. التوكن العلني القديم (X-Api-Token) مقبول انتقالياً بس لتجار موجودين قبل
# الفصل وبس من هالشبكات (n8n على نفس السيرفر بيحكي مع gunicorn مباشرة = loopback):
CONSUME_LEGACY_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# off = إطفاء المسار القديم كلياً بعد ما كل n8n يتحوّل لمفتاح الاستهلاك.
CONSUME_LEGACY_MODE=internal
