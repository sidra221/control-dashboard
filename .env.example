DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# عنوان حقيقي يوصله إنترنت (https://...) — بيستخدم لبناء رابط الـ webhook
# اللي منسجله عند Shopify لحظة ربط تاجر. لا تحطه localhost بالإنتاج.
SITE_BASE_URL=https://your-domain.com

POSTGRES_DB=control_dashboard
POSTGRES_USER=control_dashboard
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# اختر وحدة بس حسب أي مفتاح وصل: anthropic / openai / gemini
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# gpt-6-luna: أرخص وأقوى من gpt-4o بالتجربة (لغة ولهجة الزبون، الإقناع، كود الخصم).
# gpt-5.4-mini رد بالعربي على زبون عم يحكي إنجليزي، فاستبعدناه.
# OPENAI_REASONING_EFFORT: قديش يفكّر الموديل قبل ما يرد (low/medium/high) عبر الـ
# Responses API. فاضي = ما منبعته أبداً (لازم للموديلات القديمة مثل gpt-4o).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# مفتاح kie.ai — لتوليد صور تجربة اللبس (virtual try-on)
KIEAI_API_KEY=

# توكن التاجر يلي بيعرض متجر الديمو (/demo/) — انسخه من لوحة التحكم.
# فاضي = متجر الديمو مطفي (كل صفحات /demo/ بترجع 404).
DEMO_STORE_KEY=

# تطبيق سلة — من بوابة الشركاء: portal.salla.partners ← My Apps
SALLA_APP_ID=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_DEFAULT_IMAGE_QUOTA=20

# تطبيق زد — من بوابة الشركاء: partner.zid.sa ← My Apps ← General settings ← API keys
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# كلمة سر عشوائية منحطها كهيدر مخصص بتبويب Webhooks بزد (زد ما بتوقّع الإشعارات)
ZID_WEBHOOK_SECRET=
ZID_DEFAULT_IMAGE_QUOTA=20
# رصيد الصور الشهري لكل باقة: اسم الباقة أو رقمها ← عدد الصور (JSON بسطر واحد)
ZID_PLAN_QUOTAS={"Basic": 100, "Growth": 500, "Pro": 1000}

# إيميل الدعم — بيظهر بصفحة سياسة الخصوصية
SUPPORT_EMAIL=

# --- تحديد المعدّل (الودجت علني، فالـ endpoints محمية بحدود) ---
# "database" (الافتراضي): العدّادات بجدول بقاعدة البيانات، مشتركة بين كل الـ workers والسيرفرات.
# "cache": فقط لو CACHES مضبوط على Redis/Memcached (فحص النظام بيرفض LocMem/File-based).
# بعد النشر شغّل: python manage.py ratelimit_selftest
RATE_LIMIT_BACKEND=database
# عدد الـ proxies الموثوقة قدام جانغو (nginx = 1). لازم nginx يضيف X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# --- اعتماد endpoint الاستهلاك (n8n): /api/tokens/consume/ ---
# الأساسي: مفتاح الاستهلاك السرّي (X-Consume-Key) — بيتولّد من الداشبورد (عمود "استهلاك")
# وبيظهر مرة وحدة. التوكن العلني القديم (X-Api-Token) مقبول انتقالياً بس لتجار موجودين قبل
# الفصل وبس من هالشبكات (n8n على نفس السيرفر بيحكي مع gunicorn مباشرة = loopback):
CONSUME_LEGACY_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# off = إطفاء المسار القديم كلياً بعد ما كل n8n يتحوّل لمفتاح الاستهلاك.
CONSUME_LEGACY_MODE=internal
